# DeepCode v4 — overrides opcionales por proyecto
#
# La DEEPSEEK_API_KEY se configura globalmente con `deepcode --setup`
# (guardada en ~/.deepcode-v4/.env). Este archivo es solo para overrides
# por proyecto u opciones avanzadas. No es obligatorio.

# Override por proyecto (gana sobre la key global)
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# Telemetría
# DEEPCODE_DEBUG_USAGE=0
# DEEPCODE_USAGE_LOG=./usage.jsonl

# Modelos
# DEEPCODE_PRIMARY_MODEL=deepseek-v4-pro[1m]
# DEEPCODE_FAST_MODEL=deepseek-v4-flash
# DEEPCODE_HAIKU_MODEL=deepseek-v4-flash

# Upstream DeepSeek
# DEEPSEEK_API_HOST=api.deepseek.com
# DEEPSEEK_API_PORT=443
# DEEPSEEK_API_TLS=true

# Proxy tuning
# DEEPCODE_UPSTREAM_TIMEOUT=600000
# DEEPCODE_STREAM_IDLE_MS=60000
# DEEPCODE_MAX_BODY=8388608
# DEEPCODE_MAX_SOCKETS=128

# Retry
# DEEPCODE_RETRY_MAX=2
# DEEPCODE_RETRY_BASE_MS=250
# DEEPCODE_RETRY_MAX_MS=4000
# DEEPCODE_RETRY_NETWORK=true
